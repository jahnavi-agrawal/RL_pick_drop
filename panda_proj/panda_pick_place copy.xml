<mujoco model="panda_pick_place">

    <!-- Load the Franka Emika Panda -->
    <include file="panda.xml"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6"
                   ambient="0.3 0.3 0.3"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture name="ground_texture"
                 type="2d"
                 builtin="checker"
                 width="300"
                 height="300"
                 rgb1="0.2 0.3 0.4"
                 rgb2="0.1 0.2 0.3"/>

        <material name="ground_material"
                  texture="ground_texture"
                  texrepeat="5 5"/>
    </asset>

    <worldbody>

        <!-- FLOOR -->
        <geom name="floor"
              type="plane"
              size="2 2 0.05"
              material="ground_material"/>

        <!-- TABLE -->
        <body name="my_table" pos="0.7 0 0.05">

            <geom name="table_top"
                  type="box"
                  size="0.45 0.45 0.05"
                  pos="0 0 0.05"
                  rgba="0.5 0.3 0.15 1"/>

            <geom name="leg1"
                  type="box"
                  size="0.05 0.05 0.05"
                  pos="-0.35 -0.35 -0.05"
                  rgba="0.35 0.2 0.1 1"/>

            <geom name="leg2"
                  type="box"
                  size="0.05 0.05 0.05"
                  pos="-0.35 0.35 -0.05"
                  rgba="0.35 0.2 0.1 1"/>

            <geom name="leg3"
                  type="box"
                  size="0.05 0.05 0.05"
                  pos="0.35 -0.35 -0.05"
                  rgba="0.35 0.2 0.1 1"/>

            <geom name="leg4"
                  type="box"
                  size="0.05 0.05 0.05"
                  pos="0.35 0.35 -0.05"
                  rgba="0.35 0.2 0.1 1"/>

        </body>

        <!-- RED CUBE: 6 cm x 6 cm x 6 cm -->
        <body name="cube" pos="0.55 -0.15 0.18">

            <freejoint name="cube_free"/>

            <geom name="cube_geom"
                  type="box"
                  size="0.03 0.03 0.03"
                  rgba="0.8 0.05 0.05 1"
                  mass="0.1"
                  friction="2 0.01 0.001"
                  condim="4"/>

        </body>

        <!-- GREEN PICK SPOT -->
        <site name="pick_spot"
              type="cylinder"
              pos="0.55 -0.15 0.152"
              size="0.06 0.002"
              rgba="0.1 0.9 0.1 0.7"/>

        <!-- BLUE DROP SPOT -->
        <site name="drop_spot"
              type="cylinder"
              pos="0.55 0.20 0.152"
              size="0.06 0.002"
              rgba="0.1 0.3 1 0.7"/>

        <!-- LIGHT -->
        <light name="task_light"
               pos="0 0 2"
               directional="true"/>

    </worldbody>

</mujoco>